{
  "name": "Create Duplicate User",
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Duplicate email is rejected\", function () {",
          "    pm.expect(pm.response.code).to.eql(422);",
          "});",
          "",
          "pm.test(\"Error response is returned\", function () {",
          "    const data = pm.response.json();",
          "    pm.expect(data).to.be.an(\"array\");",
          "    pm.expect(data.length).to.be.above(0);",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/users",
    "header": [],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"name\": \"Duplicate User\",\n  \"gender\": \"male\",\n  \"email\": \"{{userEmail}}\",\n  \"status\": \"active\"\n}"
    },
    "auth": {
      "type": "bearer",
      "bearer": [
        {
          "key": "token",
          "value": "{{token}}",
          "type": "string"
        }
      ]
    }
  }
}
